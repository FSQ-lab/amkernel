        {"id": "android-open-chronometer", "action": "click", "locator": {"strategy": "accessibility id", "value": "Chronometer"}},
        {"id": "android-start-chronometer", "action": "click", "locator": {"strategy": "id", "value": "io.appium.android.apis:id/start"}},
        {"id": "android-wait-chronometer-change", "action": "waitAttributeChange", "attribute": "text", "timeoutSeconds": 4, "locator": {"strategy": "id", "value": "io.appium.android.apis:id/chronometer"}, "capture": true},
        {"id": "android-relaunch-for-large-tree", "action": "relaunch"},
        {"id": "android-open-views-for-large-tree", "action": "click", "locator": {"strategy": "accessibility id", "value": "Views"}},
        {"id": "android-scroll-large-tree", "action": "scrollIntoView", "locator": {"strategy": "-android uiautomator", "value": "new UiScrollable(new UiSelector().scrollable(true)).scrollIntoView(new UiSelector().description(\"WebView3\"))"}},
        {"id": "android-confirm-success", "action": "assertVisible", "locator": {"strategy": "accessibility id", "value": "WebView3"}, "capture": true},
        {"id": "android-capture-large-tree", "action": "captureSource", "minimumNodes": 20}
      ]
