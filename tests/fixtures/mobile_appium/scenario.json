      "automationName": "UiAutomator2",
      "workflow": [
        {"id": "android-launch", "action": "waitVisible", "locator": {"strategy": "accessibility id", "value": "Views"}, "capture": true},
        {"id": "android-open-views", "action": "click", "locator": {"strategy": "accessibility id", "value": "Views"}},
